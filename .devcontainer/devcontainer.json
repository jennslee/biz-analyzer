{
  "name": "biz-analyzer",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8200],
  "portsAttributes": {
    "8200": {
      "label": "사업구상 분석 앱",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "[ -f .env ] || echo 'ANTHROPIC_API_KEY=' > .env",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
