{
  "name": "biz-analyzer",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "forwardPorts": [8200],
  "portsAttributes": {
    "8200": {
      "label": "사업구상 분석 앱",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "[ -n \"$ANTHROPIC_API_KEY\" ] && echo \"ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}\" > .env; nohup python web.py > /tmp/app.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
